#!/usr/bin/env bash
# Fake kubectl for setup-eks-managed-scan.bats verify. Answers auth can-i from
# the verb/resource pair: list on API resources is yes except secrets (list
# returns values); list on subresources and every other check is no unless
# FAKE_CAN_I_YES lists "verb resource".

if [[ " $* " == *" create -f - "* ]]; then
  request="$(cat)"
  resource="$(printf '%s' "$request" | sed -n 's/.*"resource":"\([^"]*\)".*/\1/p')"
  group="$(printf '%s' "$request" | sed -n 's/.*"group":"\([^"]*\)".*/\1/p')"
  resource="${resource}${group:+.$group}"
  if [[ -n "${FAKE_CAN_I_NO:-}" && " $FAKE_CAN_I_NO " == *" list $resource "* ]]; then
    echo false
  else
    echo true
  fi
  exit 0
fi

verb=""
resource=""
previous=""
for arg in "$@"; do
  if [[ "$previous" == can-i ]]; then
    verb="$arg"
  elif [[ -n "$verb" && -z "$resource" && "$arg" != --* ]]; then
    resource="$arg"
  fi
  previous="$arg"
done

if [[ -n "${FAKE_CAN_I_NO:-}" && " $FAKE_CAN_I_NO " == *" $verb $resource "* ]]; then
  echo no
  exit 0
fi
if [[ "$verb" == get && ( "$resource" == /version || "$resource" == /api || "$resource" == /apis || "$resource" == /apis/gateway.networking.k8s.io/* || "$resource" == /apis/networking.istio.io/* ) ]]; then
  echo yes
  exit 0
fi
if [[ "$verb" == list && "$resource" != */* && "$resource" != secrets ]]; then
  echo yes
  exit 0
fi
if [[ -n "${FAKE_CAN_I_YES:-}" && " $FAKE_CAN_I_YES " == *" $verb $resource "* ]]; then
  echo yes
  exit 0
fi
echo no
