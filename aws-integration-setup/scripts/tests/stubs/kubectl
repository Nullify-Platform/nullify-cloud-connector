#!/usr/bin/env bash
# Fake kubectl for setup-eks-managed-scan.bats verify. Answers auth can-i from
# the verb/resource pair: list on API resources is yes; list on subresources
# and every other check is no unless FAKE_CAN_I_YES lists "verb resource".

verb=""
resource=""
previous=""
for arg in "$@"; do
  if [[ "$previous" == can-i ]]; then
    verb="$arg"
  elif [[ -n "$verb" && -z "$resource" && "$arg" != --* ]]; then
    resource="$arg"
  fi
  previous="$arg"
done

if [[ "$verb" == list && "$resource" != */* ]]; then
  echo yes
  exit 0
fi
if [[ -n "${FAKE_CAN_I_YES:-}" && " $FAKE_CAN_I_YES " == *" $verb $resource "* ]]; then
  echo yes
  exit 0
fi
echo no
